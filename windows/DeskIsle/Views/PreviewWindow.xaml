<Window x:Class="DeskIsle.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="#1B1B1F"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseDown"
        MinWidth="360" MinHeight="280">
    <!-- 对应 mac 的 QuickPreviewPanel / Electron 的 ImagePreview：
         双击图片时弹出来，而不是把系统的照片查看器拉到前台。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 顶部标题条：同时是拖动条（Win32 侧由 WM_NCHITTEST 返回 HTCAPTION） -->
        <Grid Grid.Row="0" Background="#242429">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NameText" Grid.Column="0"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="12" Foreground="#DDDDDD"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Width="34" Height="30"
                    Content="✕" FontSize="11"
                    Foreground="#AAAAAA" Background="Transparent" BorderThickness="0"
                    Click="CloseButton_Click" ToolTip="关闭 (Esc)" />
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   MouseLeftButtonDown="Image_MouseDown" />
            <TextBox x:Name="PreviewTextBox"
                     Visibility="Collapsed"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent"
                     Foreground="#EEEEEE"
                     BorderThickness="0"
                     FontFamily="Consolas, Cascadia Code, Courier New"
                     FontSize="12"
                     TextWrapping="Wrap" />
            <TextBlock x:Name="FallbackText"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="#808080"
                       Text="无法预览此文件" />
        </Grid>

        <TextBlock x:Name="MetaText" Grid.Row="2"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="11" Foreground="#808080" />
    </Grid>
</Window>
