<Window x:Class="DeskIsle.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="全局设置与备份" 
        Height="690" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource FluentFontFamily}"
        Topmost="True">

    <!-- 面板级资源：统一「功能块小标题」与「卡片区域」样式，避免各块自行设置导致不一致 -->
    <Window.Resources>
        <!-- 功能块小标题：位于卡片外部上方，与 macOS / Electron 版同构 -->
        <Style x:Key="BlockTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
        <!-- 卡片区域：统一的圆角、内边距与外边距 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <!-- 卡片内的行分隔线 -->
        <Style x:Key="CardDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
        <!-- 行标题 / 行副标题 -->
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="RowSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Dialog Fluent Acrylic Container (CornerRadius="8") -->
        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#12FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="*"/>    <!-- Settings Items -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Header：标题居中，无右上角关闭按钮（与 macOS / Electron 版一致，关闭走底部「完成」） -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <!-- Fluent Settings Icon: &#xE713; -->
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource FluentIconFont}" FontSize="16"
                               Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="全局设置与备份" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Settings Content (Scrollable)：7 个功能块，块标题在卡片外上方 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>

                        <!-- 1. 系统常驻 -->
                        <TextBlock Text="系统常驻" Style="{StaticResource BlockTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="开机自动启动" Style="{StaticResource RowTitleStyle}"/>
                                        <TextBlock Text="登录 Windows 系统时自动启动桌岛" Style="{StaticResource RowSubtitleStyle}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="StartupCheckBox" Grid.Column="1" VerticalAlignment="Center" Click="StartupCheckBox_Click"/>
                                </Grid>
                                <!-- ⚠️ 原「音效反馈」开关已删除：mac（唯一功能基线）与 Electron 都没有这一项，
                                     且 Windows 端只有开关读写、从未有任何播放代码 —— 是个假设置项。 -->
                            </StackPanel>
                        </Border>

                        <!-- 2. 布局与外观（列数 / 宽高 / 背景不透明度） -->
                        <TextBlock Text="布局与外观" Style="{StaticResource BlockTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- 横排最大显示分区数 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="横排最大显示分区数" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="MaxColsComboBox" Grid.Column="1" Width="96" Height="26" SelectionChanged="MaxColsComboBox_SelectionChanged">
                                        <ComboBoxItem Content="4 个"/>
                                        <ComboBoxItem Content="5 个 (默认)" IsSelected="True"/>
                                        <ComboBoxItem Content="6 个"/>
                                    </ComboBox>
                                </Grid>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 横排列高方向（只影响「顶部横向排序」） -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="横排列高方向" Style="{StaticResource RowTitleStyle}"/>
                                        <TextBlock Text="只影响「顶部横向排序」：最高的列贴哪一侧"
                                                   Style="{StaticResource RowSubtitleStyle}"/>
                                        <StackPanel.ToolTip>
                                            <TextBlock>
                                                从左到右 = 最高的列在最左，向右依次递减或相等；<LineBreak/>
                                                从右到左 = 最高的列在最右，向左依次递减或相等。<LineBreak/>
                                                各列按列高排列，因此列的左右顺序不一定等于分区列表顺序。
                                            </TextBlock>
                                        </StackPanel.ToolTip>
                                    </StackPanel>
                                    <ComboBox x:Name="TopHeightOrderComboBox" Grid.Column="1" Width="96" Height="26" SelectionChanged="TopHeightOrderComboBox_SelectionChanged">
                                        <ComboBoxItem Content="从左到右" IsSelected="True"/>
                                        <ComboBoxItem Content="从右到左"/>
                                        <ComboBox.ToolTip>
                                            <TextBlock>
                                                从左到右 = 最高的列在最左，向右依次递减或相等；<LineBreak/>
                                                从右到左 = 最高的列在最右，向左依次递减或相等。<LineBreak/>
                                                各列按列高排列，因此列的左右顺序不一定等于分区列表顺序。
                                            </TextBlock>
                                        </ComboBox.ToolTip>
                                    </ComboBox>
                                </Grid>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 默认与恢复宽度方式 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="默认与恢复宽度方式" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="WidthModeComboBox" Grid.Column="1" Width="96" Height="26" SelectionChanged="WidthModeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="自适应均分" IsSelected="True"/>
                                        <ComboBoxItem Content="固定宽度"/>
                                    </ComboBox>
                                </Grid>

                                <!-- 宽度预览 / 固定宽度备选（固定高度，避免切换时抖动） -->
                                <Grid Height="30" Margin="0,8,0,0">
                                    <Border x:Name="AutoWidthPreviewBorder" Background="#10FFFFFF" CornerRadius="6" Padding="10,0">
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock Text="按当前屏幕宽度自动计算 (间距 16px):" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="AutoWidthPreviewText" Text="364 px" Foreground="#0078D4" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="CustomWidthPanel" Background="#10FFFFFF" CornerRadius="6" Padding="10,0" Visibility="Collapsed">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="常用宽度备选:" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="280px" Height="22" Width="48" Margin="0,0,4,0" Background="#18FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" FontSize="10" Click="WidthPreset_Click" Tag="280"/>
                                                <Button Content="320px" Height="22" Width="48" Margin="0,0,4,0" Background="#18FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" FontSize="10" Click="WidthPreset_Click" Tag="320"/>
                                                <Button Content="360px" Height="22" Width="48" Margin="0,0,4,0" Background="#18FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" FontSize="10" Click="WidthPreset_Click" Tag="360"/>
                                                <Button Content="400px" Height="22" Width="48" Background="#18FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" FontSize="10" Click="WidthPreset_Click" Tag="400"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 分区默认高度 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="分区默认高度" Style="{StaticResource RowTitleStyle}"/>
                                        <Border Background="#25FF9800" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="最低 140px" Foreground="#FFB74D" FontSize="9"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="DefaultHeightBox" Width="60" Height="24"
                                                 Background="#15FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                 FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 LostFocus="DefaultHeightBox_LostFocus"/>
                                        <TextBlock Text="px" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid Columns="4" Rows="1">
                                    <Button Content="140px (下限)" Height="24" Margin="0,0,4,0" Background="#15FFFFFF" Foreground="#FFB74D" BorderBrush="#25FFFFFF" FontSize="10" Click="HeightPreset_Click" Tag="140"/>
                                    <Button Content="160px" Height="24" Margin="0,0,4,0" Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" FontSize="10" Click="HeightPreset_Click" Tag="160"/>
                                    <Button Content="200px (默认)" Height="24" Margin="0,0,4,0" Background="#15FFFFFF" Foreground="#64B5F6" BorderBrush="#25FFFFFF" FontSize="10" Click="HeightPreset_Click" Tag="200"/>
                                    <Button Content="260px" Height="24" Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" FontSize="10" Click="HeightPreset_Click" Tag="260"/>
                                </UniformGrid>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 分区最小高度 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="分区最小高度" Style="{StaticResource RowTitleStyle}"/>
                                        <Border Background="#254CAF50" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="自适应下限" Foreground="#81C784" FontSize="9"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox x:Name="MinHeightBox" Width="60" Height="24"
                                                 Background="#15FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"
                                                 FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                 ToolTip="新建分区的初始高度与「自适应宽高」的下限。未设置时跟随「分区默认高度」。"
                                                 LostFocus="MinHeightBox_LostFocus"/>
                                        <TextBlock Text="px" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <UniformGrid Columns="4" Rows="1">
                                    <Button Content="140px (下限)" Height="24" Margin="0,0,4,0" Background="#15FFFFFF" Foreground="#FFB74D" BorderBrush="#25FFFFFF" FontSize="10" Click="MinHeightPreset_Click" Tag="140"/>
                                    <Button Content="160px" Height="24" Margin="0,0,4,0" Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" FontSize="10" Click="MinHeightPreset_Click" Tag="160"/>
                                    <Button Content="200px (默认)" Height="24" Margin="0,0,4,0" Background="#15FFFFFF" Foreground="#64B5F6" BorderBrush="#25FFFFFF" FontSize="10" Click="MinHeightPreset_Click" Tag="200"/>
                                    <Button Content="260px" Height="24" Background="#15FFFFFF" Foreground="White" BorderBrush="#25FFFFFF" FontSize="10" Click="MinHeightPreset_Click" Tag="260"/>
                                </UniformGrid>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 分区背景不透明度（全局，滑动调整） -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="分区背景不透明度" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="BgOpacitySlider" Width="150" Minimum="0" Maximum="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="BgOpacitySlider_ValueChanged"/>
                                        <TextBlock x:Name="BgOpacityText" Text="60%" Foreground="#64B5F6" FontSize="11"
                                                   Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. 热键与交互 -->
                        <TextBlock Text="热键与交互" Style="{StaticResource BlockTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <!-- 全局显隐快捷键 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="全局显隐快捷键" Style="{StaticResource RowTitleStyle}"/>
                                        <TextBlock Text="一键隐藏 / 唤醒桌面所有浮岛" Style="{StaticResource RowSubtitleStyle}"/>
                                    </StackPanel>
                                    <TextBox x:Name="HotkeyBox" Grid.Column="1" Text="Alt+D" Width="90" Height="26"
                                             Background="#15FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"
                                             FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             IsReadOnly="True" Cursor="Hand" KeyDown="HotkeyBox_KeyDown"/>
                                </Grid>


                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 全局搜索快捷键：与显隐快捷键**独立注册**，改一个不会顶掉另一个 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="全局搜索快捷键" Style="{StaticResource RowTitleStyle}"/>
                                        <TextBlock Text="跨全部分区搜索文件 / 待办 / 便签" Style="{StaticResource RowSubtitleStyle}"/>
                                    </StackPanel>
                                    <TextBox x:Name="SearchHotkeyBox" Grid.Column="1" Text="Alt+F" Width="90" Height="26"
                                             Background="#15FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"
                                             FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                             IsReadOnly="True" Cursor="Hand" KeyDown="SearchHotkeyBox_KeyDown"/>
                                </Grid>


                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 边缘磁吸对齐 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="拖拽边缘磁吸对齐" Style="{StaticResource RowTitleStyle}"/>
                                        <TextBlock Text="靠近屏幕或邻近分区 16px 内自动吸附" Style="{StaticResource RowSubtitleStyle}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="SnappingCheckBox" Grid.Column="1" VerticalAlignment="Center" Click="SnappingCheckBox_Click"/>
                                </Grid>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 折叠分区悬停展开（对齐 mac 基线的 hoverPeekCollapsed）
                                     分区窗口早已消费这个配置键，但此前 Windows 端没有任何入口能改它。 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="折叠分区悬停展开" Style="{StaticResource RowTitleStyle}"/>
                                        <TextBlock Text="鼠标停在已折叠分区上时临时展开预览" Style="{StaticResource RowSubtitleStyle}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="HoverPeekCheckBox" Grid.Column="1" VerticalAlignment="Center" Click="HoverPeekCheckBox_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 4. 布局预设 -->
                        <TextBlock Text="布局预设" Style="{StaticResource BlockTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="保存 / 应用布局预设" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="记录本屏各分区的位置与尺寸，一键回到那套摆法" Style="{StaticResource RowSubtitleStyle}"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PresetNameBox" Height="26"
                                             Background="#15FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"
                                             FontSize="11" Padding="6,0" VerticalContentAlignment="Center"
                                             ToolTip="给这套摆法起个记得住的名字"/>
                                    <Button Grid.Column="1" Content="保存当前布局" Height="26" Margin="6,0,0,0" Padding="10,0"
                                            Background="#20FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"
                                            FontSize="11" Cursor="Hand" Click="PresetSave_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <ItemsControl x:Name="PresetsItemsControl" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11.5" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding Summary}" Foreground="#88FFFFFF" FontSize="9.5" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="应用" Height="24" Width="48" Margin="0,0,4,0"
                                                                Background="#250078D4" Foreground="#40A9FF" BorderThickness="0"
                                                                FontSize="10" Cursor="Hand" Click="PresetApply_Click">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                        <Button Content="删除" Height="24" Width="48"
                                                                Background="#18FFFFFF" Foreground="#FF8A80" BorderThickness="0"
                                                                FontSize="10" Cursor="Hand" Click="PresetDelete_Click">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="PresetsEmptyText" Text="尚无预设。摆好分区后在上方命名并保存。"
                                           Foreground="#66FFFFFF" FontSize="10" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 5. 显示器参数 -->
                        <TextBlock Text="显示器参数" Style="{StaticResource BlockTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="DisplaysCountText" Text="检测连接的显示器状态"
                                           Style="{StaticResource RowSubtitleStyle}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="DisplaysItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Monitor icon: &#xE7F4; -->
                                                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource FluentIconFont}" FontSize="12" Foreground="#0078D4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                                        <TextBlock Text="  ·  " Foreground="#44FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Resolution}" Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Visibility="{Binding PrimaryVisibility}" Background="#250078D4" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="主显示器" Foreground="#40A9FF" FontSize="9" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 6. 数据与备份 -->
                        <TextBlock Text="数据与备份" Style="{StaticResource BlockTitleStyle}"/>
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="配置存储" Style="{StaticResource RowTitleStyle}"/>
                                    <TextBlock Text="备份全部桌面分区与布局至 JSON 文件" Style="{StaticResource RowSubtitleStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="导出配置" Width="80" Height="26" Background="#20FFFFFF" Foreground="White"
                                            BorderBrush="#30FFFFFF" BorderThickness="1" FontSize="11" Cursor="Hand" Click="ExportConfig_Click" Margin="0,0,6,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="导入配置" Width="80" Height="26" Background="#20FFFFFF" Foreground="White"
                                            BorderBrush="#30FFFFFF" BorderThickness="1" FontSize="11" Cursor="Hand" Click="ImportConfig_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>

                                <Border Style="{StaticResource CardDividerStyle}"/>

                                <!-- 历史快照：每次保存前自动留一份（同分钟只留一份，最多 20 份） -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="历史快照" Style="{StaticResource RowTitleStyle}"/>
                                        <TextBlock x:Name="HistoryInfoText" Text="每次改动前自动留存，最多 20 份"
                                                   Style="{StaticResource RowSubtitleStyle}"/>
                                    </StackPanel>
                                    <Button x:Name="HistoryRestoreBtn" Grid.Column="1" Content="恢复最近一份" Height="26" Padding="10,0"
                                            Background="#20FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"
                                            FontSize="11" Cursor="Hand" Click="HistoryRestore_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FluentPrimaryBtnStyle}" Content="完成" Width="76" Height="30" 
                            IsDefault="True" Click="Done_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
