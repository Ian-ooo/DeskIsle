<Window x:Class="DeskIsle.Views.NewPartitionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="新建桌面浮岛分区" 
        Height="570" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource FluentFontFamily}"
        Topmost="True">
    <Grid Margin="10">
        <!-- Dialog Fluent Acrylic Container (CornerRadius="8") -->
        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" BorderThickness="1">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#12FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45"/>
            </Border.Effect>

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title Header -->
                    <RowDefinition Height="Auto"/> <!-- Type Selector -->
                    <RowDefinition Height="Auto"/> <!-- Base Config Card -->
                    <RowDefinition Height="*"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource FluentIconFont}" FontSize="15" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="新建桌面浮岛分区" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Type Selector (4 Types) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="分区形态" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="TypePortal" GroupName="PType" Content="📁 映射" IsChecked="True" Checked="Type_Checked" Style="{DynamicResource TypeRadioStyle}"/>
                        <RadioButton x:Name="TypeTodo" GroupName="PType" Content="✅ 待办" Checked="Type_Checked" Style="{DynamicResource TypeRadioStyle}"/>
                        <RadioButton x:Name="TypeNotes" GroupName="PType" Content="📝 便签" Checked="Type_Checked" Style="{DynamicResource TypeRadioStyle}"/>
                    </UniformGrid>
                </StackPanel>

                <!-- Base Config Card -->
                <Border Grid.Row="2" Background="{StaticResource SubtleFillBrush}" CornerRadius="6" Padding="14,12" Margin="0,0,0,14" BorderBrush="#15FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <!-- Partition Name Input -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="分区名称" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Width="70"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Border x:Name="TitleInputBorder" Background="#15FFFFFF" CornerRadius="6" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="8,4" Width="180">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TitleIconPrefix" Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TitleTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                                 Foreground="White" FontSize="12" MaxLength="10" TextChanged="TitleTextBox_TextChanged"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TitleErrorText" Text="名称不允许为空" Foreground="#FF5555" FontSize="10" 
                                           HorizontalAlignment="Right" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Folder Path Selection (Portal) -->
                        <StackPanel x:Name="FolderRow" Visibility="Visible">
                            <Rectangle Height="1" Fill="#10FFFFFF" Margin="0,4,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="映射目录" Foreground="#CCCCCC" FontSize="12"/>
                                    <TextBlock x:Name="FolderPathPreview" Text="桌面" Foreground="#66FFFFFF" FontSize="10" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="选择文件夹" HorizontalAlignment="Right" Padding="10,4" 
                                        Background="#20FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1" 
                                        Cursor="Hand" Click="SelectFolder_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Quick Paths Capsules -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="快捷路径:" Foreground="#55FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="桌面" Padding="6,2" FontSize="10" Background="#15FFFFFF" Foreground="#CCCCCC" 
                                        BorderThickness="0" Cursor="Hand" Click="QuickPathDesktop_Click" Margin="0,0,6,0"/>
                                <Button Content="下载" Padding="6,2" FontSize="10" Background="#15FFFFFF" Foreground="#CCCCCC" 
                                        BorderThickness="0" Cursor="Hand" Click="QuickPathDownloads_Click" Margin="0,0,6,0"/>
                                <Button Content="文档" Padding="6,2" FontSize="10" Background="#15FFFFFF" Foreground="#CCCCCC" 
                                        BorderThickness="0" Cursor="Hand" Click="QuickPathDocuments_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer Action Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Width="72" Height="30" Background="{StaticResource SubtleFillBrush}" Foreground="{StaticResource TextPrimaryBrush}" 
                            BorderThickness="0" Cursor="Hand" Click="Cancel_Click" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="CreateBtn" Style="{StaticResource FluentPrimaryBtnStyle}" Content="创建分区" Width="84" Height="30" 
                            IsDefault="True" Click="Create_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="TypeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="rbBorder" Background="{StaticResource SubtleFillBrush}" CornerRadius="4" Padding="6,7" Margin="2" BorderBrush="#12FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="rbBorder" Property="Background" Value="#250078D4"/>
                                <Setter TargetName="rbBorder" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rbBorder" Property="Background" Value="{StaticResource SubtleHoverFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
