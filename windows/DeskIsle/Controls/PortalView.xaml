<UserControl x:Class="DeskIsle.Controls.PortalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="280"
             AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
    <!-- ⚠️ 空白处右键 = `MouseLeftButtonDown` 之外的独立通道；而条目的右键交给 FileItem 上的菜单。
         两者都**动态重建**（见 FileListActions）：菜单项的数量与标题要随选区变化，
         静态 XAML 写不出「选中 3 项时显示『移到回收站（3 项）』」。 -->
    <Grid Margin="8,0,8,8" MouseLeftButtonDown="Root_MouseDown"
          ContextMenuOpening="Root_ContextMenuOpening">
        <Grid.ContextMenu>
            <ContextMenu/>
        </Grid.ContextMenu>
        <!-- 拖入高亮：不吃鼠标事件，只在悬停时露一圈蓝边，让「松手会不会生效」不用猜 -->
        <Grid.RowDefinitions>
            <!-- Breadcrumbs / Path -->
            <RowDefinition Height="Auto"/>
            <!-- Action Toolbar (Search / New Folder / Reveal / Sort / ViewMode) -->
            <RowDefinition Height="Auto"/>
            <!-- Files List / Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="DropHighlight" Grid.RowSpan="3" Margin="2"
                BorderBrush="#FF0078D4" BorderThickness="2" CornerRadius="6"
                Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- Breadcrumbs -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,4">
            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Actions Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="#10FFFFFF" CornerRadius="4" Padding="4,2">
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="11" 
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" Tag="过滤文件名..."/>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                <!-- New Folder: &#xE8F4; (NewFolder) -->
                <Button Style="{StaticResource FluentSubtleBtnStyle}" Content="&#xE8F4;" ToolTip="新建文件夹" Width="24" Height="24" Click="NewFolder_Click" Margin="0,0,2,0"/>
                <!-- Reveal: &#xED25; (OpenInNewWindow) -->
                <Button Style="{StaticResource FluentSubtleBtnStyle}" Content="&#xED25;" ToolTip="在文件资源管理器中打开" Width="24" Height="24" Click="Reveal_Click" Margin="0,0,2,0"/>
                <!-- Sort: &#xE8CB; (Sort) -->
                <Button Style="{StaticResource FluentSubtleBtnStyle}" Content="&#xE8CB;" ToolTip="切换排序方式" Width="24" Height="24" Click="Sort_Click" Margin="0,0,2,0"/>
                <!-- View Mode: &#xF0E2; (Dashboard) -->
                <Button x:Name="ToggleViewBtn" Style="{StaticResource FluentSubtleBtnStyle}" Content="&#xF0E2;" ToolTip="切换网格/列表视图" Width="24" Height="24" Click="ToggleView_Click"/>
            </StackPanel>
        </Grid>

        <!-- File List / Grid View -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="FileItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- BorderThickness 恒为 1（选中时只换颜色、不改粗细）：
                             否则选中那一刻条目会跳 1px，看起来像在抖。 -->
                        <Border x:Name="ItemBorder" Background="#0CFFFFFF" CornerRadius="6" Margin="2" Padding="6,4" Cursor="Hand"
                                BorderThickness="1" BorderBrush="Transparent"
                                AllowDrop="True"
                                DragOver="FileItem_DragOver"
                                DragLeave="FileItem_DragLeave"
                                Drop="FileItem_Drop"
                                MouseLeftButtonDown="FileItem_MouseDown"
                                PreviewMouseDown="FileItem_PreviewMouseDown"
                                PreviewMouseMove="FileItem_PreviewMouseMove">
                            <Border.ContextMenu>
                                <!-- 内容是动态的：`Opened` 里按「选区有几个」重建 -->
                                <ContextMenu Opened="ItemContextMenu_Opened"/>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="FallbackEmoji" Text="{Binding Icon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <Image x:Name="NativeIcon" Source="{Binding IconImage}" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <!-- 文件名单行（NoWrap + 省略号），悬停显示完整名称：与 mac / Electron 一致 -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" Foreground="#EEEEEE" FontSize="11.5" 
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#66FFFFFF" FontSize="10" 
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IconImage}" Value="{x:Null}">
                                <Setter TargetName="FallbackEmoji" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NativeIcon" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <!-- 选中态：强调色底 + 描边（与 mac 的 accentColor、Electron 的 sky 同源）。
                                 ⚠️ 不用白色 —— 分区背景色可配，浅色背景上白底等于没高亮。

                                 分**两档**：本窗口活动 → 满档；不活动（点了别的分区 / 桌面 / 别的 App）→ 弱档。
                                 选区是「分区本地」的、跨窗口不互相清除，所以两个分区可以同时有选区，
                                 不分档就认不出「刚选的」和「正在操作的」。

                                 ⚠️ 写法必须是「弱档打底 + 强档覆盖」，且强档声明在后：
                                 万一 `RelativeSource AncestorType=Window` 没解析出来（例如控件被放进别的宿主），
                                 结果是**恒显示弱档**（还能看见选中），而不是把选中色弄丢。 -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E0078D4"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#570078D4"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsActive}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4C0078D4"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#CC0078D4"/>
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty / Search Empty Prompt -->
        <StackPanel x:Name="EmptyPrompt" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="EmptyPromptIcon" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="26" HorizontalAlignment="Center" Foreground="#33FFFFFF" Margin="0,0,0,6"/>
            <TextBlock x:Name="EmptyPromptText" Text="此文件夹为空" Foreground="#66FFFFFF" 
                       FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,2"/>
            <TextBlock x:Name="EmptyPromptSub" Text="可将文件拖拽至此处，或右键新建" Foreground="#33FFFFFF"
                       FontSize="10" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Floating Batch Selection Capsule (when >= 2 items selected) -->
        <Border x:Name="FloatingSelectionCapsule" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,10" Background="#E5202020" CornerRadius="14" BorderBrush="#33FFFFFF" BorderThickness="1"
                Padding="10,5" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionCountText" Text="已选 2 项" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Rectangle Width="1" Height="12" Fill="#33FFFFFF" Margin="0,0,8,0"/>
                <Button x:Name="CapsuleCopyBtn" Style="{StaticResource FluentSubtleBtnStyle}" ToolTip="复制" Click="CapsuleCopy_Click" Width="20" Height="20" Margin="0,0,3,0">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="CapsuleCompressBtn" Style="{StaticResource FluentSubtleBtnStyle}" ToolTip="压缩为 ZIP" Click="CapsuleCompress_Click" Width="20" Height="20" Margin="0,0,3,0">
                    <TextBlock Text="&#xF012;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="CapsuleTrashBtn" Style="{StaticResource FluentSubtleBtnStyle}" ToolTip="移到回收站" Click="CapsuleTrash_Click" Width="20" Height="20" Margin="0,0,3,0">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FF6B6B"/>
                </Button>
                <Button x:Name="CapsuleClearBtn" Style="{StaticResource FluentSubtleBtnStyle}" ToolTip="取消选中 (Esc)" Click="CapsuleClear_Click" Width="20" Height="20">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
