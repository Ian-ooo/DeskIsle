<UserControl x:Class="DeskIsle.Controls.TodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="280"
             AllowDrop="True" Drop="UserControl_Drop" DragOver="UserControl_DragOver">
    <UserControl.Resources>
        <DataTemplate x:Key="TodoItemTemplate">
            <Border x:Name="ItemBorder" Background="#0AFFFFFF" CornerRadius="6" Margin="0,2,0,2" Padding="6,4"
                    BorderThickness="1" BorderBrush="Transparent"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="ItemBorder_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ItemBorder_PreviewMouseMove"
                    DragOver="ItemBorder_DragOver"
                    DragLeave="ItemBorder_DragLeave"
                    Drop="ItemBorder_Drop">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="切换完成状态" Click="ContextMenuToggle_Click"/>
                        <MenuItem Header="设置优先级">
                            <MenuItem Header="🔴 高优先级" Click="ContextMenuSetHighPriority_Click"/>
                            <MenuItem Header="🟠 中优先级" Click="ContextMenuSetMediumPriority_Click"/>
                            <MenuItem Header="⚪ 低优先级" Click="ContextMenuSetLowPriority_Click"/>
                        </MenuItem>
                        <MenuItem Header="编辑待办" Click="ContextMenuEdit_Click"/>
                        <Separator/>
                        <MenuItem Header="清除已完成待办" Click="ClearCompleted_Click"/>
                        <Separator/>
                        <MenuItem Header="删除该条" Click="DeleteTodo_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Completed Checkbox -->
                    <CheckBox Grid.Column="0" IsChecked="{Binding Completed}" VerticalAlignment="Center" Margin="0,0,6,0" Click="CheckBox_Click"/>

                    <!-- Todo Text Display & Edit -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DisplayText" Text="{Binding Text}" Foreground="#E0E0E0" FontSize="12" 
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" 
                                   MouseLeftButtonDown="DisplayText_MouseLeftButtonDown" ToolTip="双击编辑待办">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="Foreground" Value="#66FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="EditBox" Visibility="Collapsed" Background="#26FFFFFF" BorderBrush="#40FFFFFF" 
                                 BorderThickness="1" Foreground="White" FontSize="12" Padding="2,1"
                                 KeyDown="EditBox_KeyDown" LostFocus="EditBox_LostFocus"/>
                    </Grid>

                    <!-- Priority Dot (常驻显示，可直接点击切换优先级) -->
                    <Button Grid.Column="2" Width="14" Height="14" Margin="4,0,2,0" VerticalAlignment="Center" 
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Priority_Click" ToolTip="优先级，点击切换">
                        <Button.Template>
                            <ControlTemplate>
                                <Ellipse Width="8" Height="8" Fill="{Binding PriorityColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Delete Button (鼠标悬停在 ItemBorder 时显示) -->
                    <Button x:Name="DeleteBtn" Grid.Column="3" Style="{StaticResource FluentSubtleBtnStyle}" Content="&#xE8BB;" 
                            FontSize="9" Width="18" Height="18" Margin="2,0,0,0" VerticalAlignment="Center" 
                            Click="DeleteTodo_Click" ToolTip="删除待办" Opacity="0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeleteBtn" Property="Opacity" Value="1"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="FilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="5,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#250078D4"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Box + Filter Bar (固定在顶部，与 mac 对齐) -->
        <StackPanel Grid.Row="0" Margin="8,4,8,2">
            <Border Padding="6,4" Background="#15FFFFFF" CornerRadius="6" BorderBrush="#20FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource FluentIconFont}" Foreground="#66FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="InputBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" 
                             VerticalAlignment="Center" KeyDown="InputBox_KeyDown"/>
                    <!-- 清除已完成按钮 -->
                    <Button x:Name="ClearCompletedBtn" Grid.Column="2" Style="{StaticResource FluentSubtleBtnStyle}" 
                            Content="&#xE894;" FontSize="10" Width="20" Height="20" Margin="4,0,0,0" 
                            VerticalAlignment="Center" Click="ClearCompleted_Click" ToolTip="清除已完成待办" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Filter Buttons: 全部 / 未完成 / 高优 -->
            <StackPanel Orientation="Horizontal" Margin="2,4,0,2">
                <RadioButton x:Name="FilterAllBtn" Content="全部" IsChecked="True" Style="{StaticResource FilterRadioStyle}" Click="FilterBtn_Click" Tag="all"/>
                <RadioButton x:Name="FilterActiveBtn" Content="未完成" Style="{StaticResource FilterRadioStyle}" Click="FilterBtn_Click" Tag="active" Margin="4,0,0,0"/>
                <RadioButton x:Name="FilterHighBtn" Content="高优" Style="{StaticResource FilterRadioStyle}" Click="FilterBtn_Click" Tag="high" Margin="4,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Content Area: 空状态或列表 -->
        <Grid Grid.Row="1">
            <!-- 空状态提示 (与 mac 对齐) -->
            <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource FluentIconFont}" FontSize="24" Foreground="#66FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="暂无待办" FontSize="12" Foreground="#88FFFFFF" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Todo List -->
            <ScrollViewer x:Name="TodoScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,2,8,4">
                <ScrollViewer.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="清除已完成待办" Click="ClearCompleted_Click"/>
                    </ContextMenu>
                </ScrollViewer.ContextMenu>
                <StackPanel>
                    <!-- 未完成待办列表 -->
                    <ItemsControl x:Name="TodoItemsControl" ItemTemplate="{StaticResource TodoItemTemplate}"/>

                    <!-- 已完成待办折叠分组头部 -->
                    <Border x:Name="CompletedSectionHeader" Background="Transparent" Padding="6,6,6,4" Cursor="Hand" 
                            MouseLeftButtonDown="CompletedHeader_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CompletedChevron" Text="&#xE76C;" FontFamily="{StaticResource FluentIconFont}" 
                                       FontSize="9" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="CompletedTitle" Text="已完成 (0)" FontSize="11" 
                                       Foreground="#88FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 已完成待办列表 (默认折叠收起) -->
                    <ItemsControl x:Name="CompletedItemsControl" ItemTemplate="{StaticResource TodoItemTemplate}" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
