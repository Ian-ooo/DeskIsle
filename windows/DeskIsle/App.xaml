<Application x:Class="DeskIsle.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Windows 11 Fluent Design System Resources -->
        <!-- Typography -->
        <FontFamily x:Key="FluentFontFamily">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
        <FontFamily x:Key="FluentIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Fluent Color Palette (Dark Mode) -->
        <SolidColorBrush x:Key="FluentAccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="FluentAccentHoverBrush" Color="#1E90FF"/>
        <SolidColorBrush x:Key="FluentAccentPressedBrush" Color="#005A9E"/>

        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#991C1C22"/>
        <SolidColorBrush x:Key="SubtleFillBrush" Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="SubtleHoverFillBrush" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="SubtlePressedFillBrush" Color="#26FFFFFF"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#4DFFFFFF"/>

        <!-- Fluent Subtle Icon Button Style -->
        <Style x:Key="FluentSubtleBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentIconFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SubtleHoverFillBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SubtlePressedFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Accent Primary Button Style -->
        <Style x:Key="FluentPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FluentAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource FluentAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource FluentAccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
